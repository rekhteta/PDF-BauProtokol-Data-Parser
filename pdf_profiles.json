                    {
                        "type": "regex",
                        "pattern": "Meterzahlen[:\\s]*\\n?\\s*([0-9]+\\s*/\\s*[0-9]+)",
                        "group": 1,
                        "pick": "first"
                    },
                    {
                        "type": "regex_combine",
                        "patterns": [
                            "Start-?Zahl\\(m\\)[:\\s]*\\n?(\\d+)",
                            "Ende-?Zahl\\(m\\)[:\\s]*\\n?(\\d+)"
                        ],
                        "format": "{0} / {1}"
                    },
                    {
                        "type": "regex_combine",
                        "patterns": [
                            "Start:\\s*(\\d+)\\s*(?:m\\b)?",
                            "Ende:\\s*(\\d+)"
                        ],
                        "format": "{0} / {1}"
                    }
                ]
            }
